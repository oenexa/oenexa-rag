{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "domain": "com.oenexa.rag",
  "version": "1.0.0",
  "events": [
    {
      "type": "com.oenexa.rag.document.indexed.v1",
      "description": "Emitted when a new document is vectorized into the knowledge base",
      "schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "data": {
            "type": "object",
            "properties": {
              "documentId": { "type": "string" },
              "chunkId": { "type": "string" },
              "dimension": { "type": "integer", "example": 256 }
            },
            "required": ["documentId", "chunkId"]
          }
        }
      }
    }
  ]
}
